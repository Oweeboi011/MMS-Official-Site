# Copy to .env.local (gitignored). Firebase web config: `cd src/backend && npx firebase-tools@15 apps:sdkconfig WEB`.
# Not secret (rules + App Check protect data), but kept out of git so gitleaks stays clean.
VITE_FIREBASE_API_KEY=   # append "# gitleaks:allow" to this line: public web key, but gitleaks flags its shape
VITE_FIREBASE_AUTH_DOMAIN=mms-official-site-513809.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mms-official-site-513809
VITE_FIREBASE_APP_ID=1:729371585953:web:3bc72ba88bd5b127fd2fe0
# App Check: reCAPTCHA Enterprise site key (public; Google Cloud → Fraud Defense, key "MMS site App Check (web)"). Blank = App Check off.
VITE_APP_CHECK_SITE_KEY=   # append "# gitleaks:allow": public key, but gitleaks flags its shape
# false = read-only build (preview; scripts/deploy.mjs sets it). Blank = writes on.
VITE_WRITES_ENABLED=
# true = climb registration on this site (off until the switch from mms-open-climbs; emulators only before then)
VITE_REGISTRATION_ENABLED=
# true = local emulators (cd src/backend && npx firebase-tools@15 emulators:start --only auth,firestore), never prod data
VITE_USE_EMULATORS=false
