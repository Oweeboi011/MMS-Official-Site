{
  "name": "mms-official-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c .config/playwright.config.ts",
    "test:perf": "node tests/performance/bundle-budget.mjs",
    "lint": "eslint .",
    "check:secrets": "node tools/secrets.mjs",
    "check:deps": "depcruise --config .config/dependency-cruiser.cjs src/frontend src/backend/functions/src",
    "check:dead": "knip --config .config/knip.json",
    "check:dupes": "jscpd --config .config/jscpd.json",
    "check:audit": "npm audit --audit-level=high && npm audit --prefix src/backend/functions --audit-level=high",
    "check:images": "node tests/performance/image-budget.mjs",
    "check": "npm run check:secrets && npm run typecheck && npm run lint && npm run check:deps && npm run check:dead && npm run check:dupes && npm run check:images && npm test",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:prod": "node scripts/deploy.mjs main",
    "prepare": "git config core.hooksPath .githooks",
    "test:parity": "node scripts/prod-parity.mjs",
    "test:rules": "npx -y firebase-tools@15.35.0 emulators:exec --config src/backend/firebase.json --only firestore,storage --project demo-rules \"node tests/integration/rules.emulator.mjs\""
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "kill-port": "^2.0.1",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "minimatch": "^11.0.1"
  }
}
