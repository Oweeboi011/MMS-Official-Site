{
  "name": "mms-official-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "node tests/performance/bundle-budget.mjs",
    "lint": "eslint .",
    "check:secrets": "secretlint \"**/*\"",
    "check:deps": "depcruise src",
    "check:dead": "knip",
    "check:dupes": "jscpd",
    "check:audit": "npm audit --audit-level=high",
    "check": "npm run check:secrets && npm run typecheck && npm run lint && npm run check:deps && npm run check:dead && npm run check:dupes && npm test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.2",
    "kill-port": "^2.0.1",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.1.0",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "secretlint",
    "*.{ts,tsx,js,mjs}": "eslint --max-warnings=50"
  }
}
