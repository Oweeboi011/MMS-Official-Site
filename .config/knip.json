{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/*.mjs",
        "scripts/*.mjs",
        "tests/**/*.{ts,tsx,mjs,js}"
      ],
      "project": [
        "src/frontend/**/*.{ts,tsx}",
        "tools/**/*.mjs",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,tsx,mjs,js}"
      ],
      "ignoreDependencies": [
        "kill-port",
        "lint-staged",
        "wrangler",
        "firebase-admin",
        "@google-cloud/bigquery"
      ]
    },
    "src/backend/functions": {
      "project": [
        "src/**/*.js"
      ]
    }
  },
  "ignoreBinaries": [
    "gitleaks",
    "firebase"
  ]
}
